# Optional OpenAI is unused — Copilot uses Vertex AI (Gemini) via ADC.
# OPENAI_API_KEY=

# GCP (npm run login). Default project matches the personal stack.
GCP_PROJECT_ID=personal-suherman
# GCP_USER_EMAIL=
GOOGLE_APPLICATION_CREDENTIALS=.gcloud/application_default_credentials.json

# Vertex AI (Gemini). Requires `npm run login` + Vertex AI API enabled.
VERTEX_AI_LOCATION=global
VERTEX_MODEL=gemini-2.5-flash
# Force backend: vertex | mock (default: vertex when ADC+project exist)
# AGENT_BACKEND=vertex
